# =====================================================================
# Пример настроек. Скопировать в .env и подставить свои значения:
#   cp .env.example .env
# Файл .env в репозиторий не попадает (он в .gitignore).
# =====================================================================

# --- Подключение кабинета к облачному Supabase -----------------------
# Берутся в панели проекта: Settings → API.
# Оба значения не секретные: адрес виден в запросах браузера, а ключ
# anon работает только вместе с политиками доступа (RLS) — без входа
# он не отдаёт ничего. Секретный ключ (service_role) в приложении
# не используется вообще и в репозиторий попадать не должен.
VITE_SUPABASE_URL=https://<идентификатор-проекта>.supabase.co
VITE_SUPABASE_ANON_KEY=<публичный ключ anon>

# --- Локальная песочница в Docker ------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<придумайте пароль для локальной базы>
POSTGRES_DB=lerree_demo
POSTGRES_PORT=54329
